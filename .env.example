# ── Dashboard authentication (REQUIRED) ─────────────────────────
# The auth gate engages on every non-loopback bind. If these are unset the
# dashboard fails closed and takes the container down with it.
# --insecure and HERMES_DASHBOARD_INSECURE are accepted but IGNORED.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change_me_to_a_long_random_string

# ── Runtime ─────────────────────────────────────────────────────
# Port the dashboard binds to. Railway injects this automatically.
PORT=8080

# Agent home. Keep it inside the /opt/data volume so state persists.
# HERMES_HOME=/opt/data

# ── Notes ───────────────────────────────────────────────────────
# LLM provider keys and messaging channel tokens (Telegram, Discord, Slack,
# WhatsApp, WeChat) are configured in the WebUI after first login — not here.
